# Igris settings reference. Every setting is an IGRIS_* environment variable.
# Lines left commented keep the built-in default; uncomment a line only to change it.
# Never put real secrets in this file. Secrets marked [keyring] are read from the OS
# keyring (service "igris", name without the IGRIS_ prefix, see tools/set_keys.py) first;
# the IGRIS_<NAME> environment variable is only a fallback.

# --- Core --------------------------------------------------------------------
# Assistant display name.
# IGRIS_NAME=Igris
# User name of the regular (non-owner) account that --setup-users creates; a-z, 0-9, _ or -.
# IGRIS_GUEST_USERNAME=guest
# Folder for all state (memory, sessions, accounts, budget); default ~/.igris. Must not be empty.
# IGRIS_DATA_DIR=
# Individual state paths; each defaults to a file or folder inside IGRIS_DATA_DIR.
# IGRIS_MEMORY_PATH=
# IGRIS_SESSIONS_DIR=
# IGRIS_PERSONAS_DIR=
# IGRIS_BUDGET_PATH=
# IGRIS_JOBS_PATH=
# Persona name, [A-Za-z0-9_-]{1,40}.
# IGRIS_PERSONA=default
# Chat turns kept in the prompt history.
# IGRIS_MAX_HISTORY=20
# Seconds before a model call is abandoned.
# IGRIS_TIMEOUT=300
# Folder the owner's file tools and multiagent jobs work in; empty disables the file tools.
# IGRIS_WORKSPACE=
# Path to a multiagent checkout; unset auto-detects ../multiagent, empty disables it.
# IGRIS_MULTIAGENT_DIR=
# Parallel multiagent workers, 1-4.
# IGRIS_MA_PARALLEL=1
# Background task workers, 1-4.
# IGRIS_TASK_WORKERS=2
# Owner's course library and study workspace (0 or 1).
# IGRIS_CORE=1
# IGRIS_STUDY=1

# --- Web server ----------------------------------------------------------------
# Bind address; keep loopback unless the server sits behind TLS and the built-in login.
# IGRIS_HOST=127.0.0.1
# Public HTTPS origin (no path) when served behind a reverse proxy, e.g. https://igris.example.com.
# IGRIS_PUBLIC_ORIGIN=
# Uploaded files: per-file size (MB, max 200), per-account total (MB, max 10000),
# per-account count (max 10000).
# IGRIS_FILE_MAX_MB=25
# IGRIS_FILE_QUOTA_MB=500
# IGRIS_FILE_MAX_COUNT=500
# [keyring] Shared token for the edge daemon (igris.edge refuses to start without it).
# IGRIS_EDGE_TOKEN=

# --- Models and paid usage -----------------------------------------------------
# Owner backends in fallback order: claude, codex, opencode, echo, openai, gemini, ollama,
# openrouter, groq, cerebras, mistral, nvidia, cloudflare, sambanova, cohere.
# IGRIS_BACKENDS=claude,codex
# Backends treated as slow (longer waits, background use).
# IGRIS_SLOW_BACKENDS=claude,codex
# Backends a regular (non-owner) account may use; CLI backends are not allowed here.
# IGRIS_USER_BACKENDS=ollama
# Model names per backend.
# IGRIS_CLAUDE_MODEL=sonnet
# IGRIS_CODEX_MODEL=gpt-6-astra
# IGRIS_OPENCODE_MODEL=deepseek-v4.1-flash-free
# IGRIS_OPENAI_MODEL=gpt-4o
# IGRIS_GEMINI_MODEL=gemini-3.8-flash
# IGRIS_OLLAMA_MODEL=qwen3:4b
# IGRIS_OLLAMA_URL=http://localhost:11434
# Optional model override per free OpenAI-compatible provider; must not be empty when set.
# IGRIS_OPENROUTER_MODEL=
# IGRIS_GROQ_MODEL=
# IGRIS_CEREBRAS_MODEL=
# IGRIS_MISTRAL_MODEL=
# IGRIS_NVIDIA_MODEL=
# IGRIS_CLOUDFLARE_MODEL=
# IGRIS_SAMBANOVA_MODEL=
# IGRIS_COHERE_MODEL=
# Allow free providers that may train on prompts (0 or 1).
# IGRIS_ALLOW_TRAINING_PROVIDERS=0
# Only the exact value 1 allows API billing instead of the subscription; anything else blocks it.
# IGRIS_ALLOW_PAID=0
# Daily spending cap in USD for the OpenAI API backend.
# IGRIS_OPENAI_DAILY_BUDGET_USD=1.0
# [keyring] Provider API keys.
# IGRIS_OPENAI_API_KEY=
# IGRIS_GEMINI_API_KEY=
# IGRIS_OPENROUTER_API_KEY=
# IGRIS_GROQ_API_KEY=
# IGRIS_CEREBRAS_API_KEY=
# IGRIS_MISTRAL_API_KEY=
# IGRIS_NVIDIA_API_KEY=
# IGRIS_CLOUDFLARE_API_TOKEN=
# IGRIS_CLOUDFLARE_ACCOUNT_ID=
# IGRIS_SAMBANOVA_API_KEY=
# IGRIS_COHERE_API_KEY=
# Fast Claude CLI alias for small study tasks; empty inherits IGRIS_WEB_MODEL.
# IGRIS_STUDY_FAST_MODEL=haiku
# Vision transcription model; empty or unset inherits IGRIS_WEB_MODEL.
# IGRIS_VISION_MODEL=

# --- Mail ----------------------------------------------------------------------
# [keyring] Google OAuth sign-in for Gmail and Calendar (stored by tools/gmail_auth.py login).
# IGRIS_GMAIL_CLIENT_ID=
# IGRIS_GMAIL_CLIENT_SECRET=
# IGRIS_GMAIL_REFRESH_TOKEN=
# Seconds between inbox polls, 60-3600.
# IGRIS_INBOX_INTERVAL=300
# Old daily digest of "important" mail (0 or 1); off: only tasks and security problems notify.
# IGRIS_MAIL_DIGEST=0
# Local hour (0-23) of the daily digest.
# IGRIS_DIGEST_HOUR=19
# Approved outgoing mail: max combined To and Cc recipients (1-20), sent mails per local
# calendar day (1-200), days before one unanswered-mail reminder (1-30).
# IGRIS_MAIL_MAX_RECIPIENTS=5
# IGRIS_MAIL_DAILY_LIMIT=20
# IGRIS_MAIL_FOLLOWUP_DAYS=3
# Owner's second mailbox, excluded as self-mail; never used as a guessed recipient.
# IGRIS_SCHOOL_ADDRESS=
# Comma-separated domains of a mailbox forwarded into Gmail, e.g. example.edu.
# IGRIS_SCHOOL_DOMAINS=
# One sentence about you that the mail-sorting model is told (at most 500 characters), e.g.
# "The owner is a university student who also volunteers for a student organisation (branch esn)."
# Empty uses: "The owner is a busy individual managing study, work and personal mail."
# IGRIS_OWNER_CONTEXT=

# --- Telegram and notifications ------------------------------------------------
# [keyring] Telegram bot token and the owner's numeric chat id.
# IGRIS_TELEGRAM_BOT_TOKEN=
# IGRIS_TELEGRAM_CHAT_ID=
# [keyring] ntfy topic, an alternative notification channel.
# IGRIS_NTFY_TOPIC=
# Local hour (0-23) of the morning summary; empty or "off" turns it off.
# IGRIS_MORNING_HOUR=8

# --- Calendar ------------------------------------------------------------------
# Up to 5 shared Google Calendar ids (comma-separated) read into the task calendar.
# IGRIS_ESN_CALENDAR_ID=
# [keyring] Private iCal feed URL of a course platform (Moodle).
# IGRIS_MOODLE_ICAL_URL=

# --- Research and browsing -----------------------------------------------------
# Owner's web research chat tool (0 or 1), seconds per call (10-600), Claude model.
# IGRIS_WEB_RESEARCH=1
# IGRIS_WEB_TIMEOUT=120
# IGRIS_WEB_MODEL=sonnet
# Official exchange-rate chat tool (0 or 1).
# IGRIS_FX_RATES=1
# Owner's page-reading tool in the real browser (0 or 1), allowed registrable domains
# (comma-separated, the main guard; empty by default, which keeps the tool off),
# seconds per call (30-600).
# IGRIS_BROWSER_READ=1
# IGRIS_BROWSER_DOMAINS=example.com
# IGRIS_BROWSER_TIMEOUT=150
